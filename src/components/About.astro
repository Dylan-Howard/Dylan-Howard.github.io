---
// src/components/About.astro
import ArrowLink from './ArrowLink.astro';
import { SITE, MAILTO } from '../config/site';
import SectionDivider from './SectionDivider.astro';
---

<section id="about" class="about-section" aria-labelledby="about-heading">
  <div class="container">

    <SectionDivider numeral="02" label="About" />

    <div class="about-grid">

      <!-- Main copy -->
      <div class="about-body-col">
        <h2 class="about-heading" id="about-heading">
          I build systems<br />
          <em>that people depend on.</em>
        </h2>

        <div class="about-copy">
          <p>
            I&rsquo;m a software engineer at Warren County Public Schools, where for five years I&rsquo;ve
            built the provisioning, sync, and integration layer behind 21,000&nbsp;students and staff.
            Most of that work is invisible when it goes right. A substitute signs in on their first
            morning. A former employee&rsquo;s access ends when they leave. I like building the kind of
            system nobody has to think about.
          </p>
          <p>
            That system didn&rsquo;t stay in one district. The Kentucky Department of Education and
            Identity Automation deployed it across 171&nbsp;districts, about 750,000&nbsp;users, and I
            advised on the rollout. In June 2025 I spoke at the <em>Identity Automation User Group</em>
            on flexible authentication for K-12.
          </p>
          <p>
            Outside the district, I&rsquo;ve built a Go service on AWS that reconciled restaurant sales
            against bank deposits, and shipped a full-stack feature on contract for RedRover. Lately
            I&rsquo;m most curious about storage and data internals.
          </p>
          <h3>The Path So Far</h3>
          <ul class="about-copy-list">
            <li class="about-copy-item">
              <span><em>Data engineering:</em> Replaced a nightly full load with a delta sync that took new-hire accounts from a worst case of 48&nbsp;hours to about a minute.</span>
            </li>
            <li class="about-copy-item">
              <span><em>Internal tooling:</em> Built a .NET and Next.js control plane that finds orphaned, duplicate, and mismatched accounts across systems.</span>
            </li>
            <li class="about-copy-item">
              <span><em>Backend:</em> Built and ran a Go reconciliation service that validated $18M+ in revenue over a year.</span>
            </li>
          </ul>
        </div>

        <div class="about-links">
          <ArrowLink href={SITE.links.github}                        label="GitHub"   />
          <ArrowLink href={SITE.links.linkedin}    label="LinkedIn" />
          <ArrowLink href="/#contact"                                               label="Get in touch" />
        </div>
      </div>

      <!-- Sidebar facts -->
      <aside class="about-aside" aria-label="Quick facts">
        <dl class="facts-card">
          <div class="fact">
            <dt class="section-label">Current role</dt>
            <dd class="fact__val">Software Engineer, WCPS</dd>
          </div>
          <div class="fact">
            <dt class="section-label">Location</dt>
            <dd class="fact__val">Bowling Green, KY</dd>
          </div>
          <div class="fact">
            <dt class="section-label">Focus</dt>
            <dd class="fact__val fact__val--accent">Backend &amp; Data Systems / Full-Stack</dd>
          </div>
          <div class="fact">
            <dt class="section-label">Education</dt>
            <dd class="fact__val fact__val--sm">
              B.S. Computer Science<br />
              <span class="fact__sub">Western Kentucky Univ. &rsquo;18</span>
            </dd>
          </div>
        </dl>

        <div class="recognition-block" aria-label="Awards and speaking">
          <p class="section-label recognition-block__label">Recognition &amp; Speaking</p>
          <ul class="recognition-list">
            <li class="recognition-item">
              <span class="recognition-item__mark" aria-hidden="true">◆</span>
              <span>Speaker — Identity Automation User Group, June 2025</span>
            </li>
          </ul>
        </div>
      </aside>

    </div>
  </div>
</section>

<style>
  .about-section {
    padding-bottom: var(--space-24);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-16);
    align-items: start;
  }

  /* Heading */
  .about-heading {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: var(--space-8);
  }

  .about-heading em {
    font-style: italic;
    color: var(--accent);
  }

  /* Copy */
  .about-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .about-copy p {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.82;
    color: var(--ink-soft);
    max-width: 58ch;
  }

  .about-copy-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-8);
  }

  .about-copy-item {
    display: flex;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--ink-soft);
    line-height: 1.82;
    max-width: 58ch;
  }

  .about-copy-item::before {
    content: "◆";
    flex-shrink: 0;
    margin-top: 0.55em;
    font-size: 0.7rem;
    font-style: normal;
  }

  /* Links row */
  .about-links {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  /* Sidebar */
  .about-aside {
    position: sticky;
    top: calc(57px + var(--space-8)); /* header height + breathing room */
  }

  /* Facts card */
  .facts-card {
    border: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
  }

  .fact {
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .fact:last-child {
    border-bottom: none;
  }

  .fact__val {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--ink);
    line-height: 1.3;
  }

  .fact__val--accent {
    color: var(--accent);
    font-style: italic;
  }

  .fact__val--sm {
    font-size: var(--text-md);
  }

  .fact__sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    letter-spacing: 0.06em;
  }

  /* Recognition block */
  .recognition-block {
    margin-top: 1px; /* gap-less join to facts-card */
    border: 1px solid var(--rule);
    border-top: none;
    padding: var(--space-4) var(--space-6);
    background: var(--parchment);
  }

  .recognition-block__label {
    display: block;
    margin-bottom: var(--space-3);
  }

  .recognition-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .recognition-item {
    display: flex;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--ink-soft);
    line-height: 1.55;
    font-style: italic;
  }

  .recognition-item__mark {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 1px;
    font-style: normal;
    font-size: 0.7rem;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .about-aside {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .about-links {
      gap: var(--space-6);
    }
  }
</style>
